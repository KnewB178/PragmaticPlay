except Exception as _np_err:
    # 清掉半残的 numpy 子模块，免得 PP EV.py 拿到坏模块
    for _k in [k for k in list(sys.modules) if k == "numpy" or k.startswith("numpy.")]:
        sys.modules.pop(_k, None)
