        except EOFError:
            raise RuntimeError("no bet amount entered")
        if not raw:
            log("  [💰] Bet amount: auto (table minimum)", Fore.CYAN)
            return None
        try:
            amt = int(float(raw))
        except ValueError:
            print("  Not a number — enter an integer (e.g. 10):")
            continue
