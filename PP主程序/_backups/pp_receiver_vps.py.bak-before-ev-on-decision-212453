function renderPlayerPanel(nm){
  const d = tables[nm]
  const body = $('#pp-body')
  if(!d || !d.players || !Object.keys(d.players).length){
    $('#pp-dealer').innerHTML = ''
    body.innerHTML='<div class="pp-empty" style="grid-column:1/-1">No player data</div>'
    return
  }
  // Update title with TC
  const tcv = d.tc ?? 0
  const tcCls = tcv > 0 ? 'g' : tcv < 0 ? 'b' : 'z'
  const tcsign = tcv > 0 ? '+' : ''
  
  $('#pp-title').innerHTML = nm + '<span style="margin-left:20px;color:var(--text-dim)">'+(d.total ?? 0)+'</span><span class="pp-hand-score '+tcCls+'" style="margin-left:20px">'+tcsign+tcv.toFixed(2)+'</span>'
  // Dealer
  const dealer = d.dealer
  if(dealer && dealer.cards && dealer.cards.length){
    const dc = dealer.cards.map(c =>
      '<span class="card-chip'+(c.indexOf('\u2665')>=0||c.indexOf('\u2666')>=0?' r':'')+'">'+esc(c)+'</span>'
    ).join('')
    const sc = parseInt(dealer.score)
    const scCls = isNaN(sc) ? 'z' : (sc > 21 ? 'b' : (sc === 21 ? 'g' : 'z'))
    var dealerUp = dealer.cards[0]||''
    var isAce = dealerUp.indexOf('A')>=0||dealerUp.indexOf('1')>=0
    $('#pp-dealer').innerHTML = '<span style="color:var(--text-dim);font-size:12px">Dealer </span>' + dc + '<span class="dscore '+scCls+'">&nbsp;'+esc(dealer.score)+'</span>'+(isAce?' <span class="pp-ins" id="ins-'+nm+'" style="font-size:10px;color:var(--yellow);margin-left:4px">Ins...</span>':'')
  } else {
    $('#pp-dealer').innerHTML = ''
  }
  const seats = {}
  const nmap = d.player_names || {}
  for(const [key, p] of Object.entries(d.players)){
    const parts = key.split('_')
    const seatNum = parts[0]
    const handIdx = parts.length > 1 ? (parseInt(parts[1].replace('h','')) || 0) : 0
    if(!seats[seatNum]) seats[seatNum] = []
    seats[seatNum].push({hand: handIdx, cards: p.cards || [], score: p.score || '?', cashOut: p.cashOut, bet: p.bet})
  }
  let html = ''
  for(let si = 1; si <= 7; si++){
    const s = String(si)
    if(seats[s]){
      const hands = seats[s]
      const playerName = nmap[s] || ''
      var _isMatch=!followedPlayer||(playerName&&playerName.includes(followedPlayer))
      const cardHtml = (cards) => cards.map(c =>
        '<span class="card-chip'+(c.indexOf('\u2665')>=0||c.indexOf('\u2666')>=0?' r':'')+'">'+esc(c)+'</span>'
      ).join('')
      html += '<div class="pp-col' + (_isMatch?' tracked':'') + '">'
      // Find cashout from first hand that has it
      var _co=null
      for(var _ci=0;_ci<hands.length;_ci++){if(hands[_ci].cashOut!==undefined){_co=hands[_ci].cashOut;break}}
      html += '<div class="pp-top"><span class="pp-seat">Seat '+s+'</span>'
      if(playerName) html += '<span class="pp-pname">'+esc(playerName)+'</span>'
      html += '<span style="flex:1"></span>'
      if(_co!==null) html += '<span style="color:var(--yellow);font-size:10px">$'+_co+'</span>'
      
      html += '</div>'
      hands.sort((a,b) => a.hand - b.hand)
      for(const h of hands){
        html += '<div class="pp-hand">'
        html += '<div class="pp-hand-cards">'
        if(h.cards.length){
          html += cardHtml(h.cards)
        }
        const sc = parseInt(h.score)
        const scCls = isNaN(sc) ? 'z' : (sc > 21 ? 'b' : (sc === 21 ? 'g' : 'z'))
        html += '<span class="pp-hand-score '+scCls+'">'+esc(h.score)+'</span>'

        html += '</div>'
        // Show EV result if cashOut exists and player is tracked
        html += '<div class="pp-ev-wrap" id="ev-'+nm+'-'+s+'-'+h.hand+'">'+evHtmlFor(d.cards||[],(d.dealer&&d.dealer.cards)||[],h.cards||[])+'</div>'
        html += '</div>'
      }
      html += '</div>'
    } else {
      html += '<div class="pp-col"><div class="pp-empty">-</div></div>'
    }
  }
  body.innerHTML = html
  // Auto-fetch insurance EV if dealer shows A
  if(d && d.dealer && d.dealer.cards && d.dealer.cards.length){
    var _up=d.dealer.cards[0]||''
    if(_up.indexOf('A')>=0||_up.indexOf('1')>=0){
      var insEl=document.getElementById('ins-'+nm)
      if(insEl&&!insEl.dataset.fetching){
        insEl.dataset.fetching='1'
        fetchEv(d.cards||[], d.dealer.cards||[], [], null).then(function(evr){
          var el=document.getElementById('ins-'+nm)
          if(!el) return
          if(!evr||!evr.insurance_ev){el.textContent='';return}
          el.textContent='Ins '+evr.insurance_ev
        })
      }
    }
  }
  // Auto-fetch EV for tracked players with cashOut
  if(!d || !followedPlayer) return
  for(const seatNum in seats){
    const pname=(d.player_names||{})[seatNum]||''
    if(!pname.includes(followedPlayer)) continue
    for(const h of seats[seatNum]){
      if(h.cashOut===undefined || h.cashOut===null) continue
      const elId='ev-'+nm+'-'+seatNum+'-'+h.hand
      const el=document.getElementById(elId)
      if(!el||el.dataset.fetching==='1') continue
      el.dataset.fetching='1'
      fetchEv(d.cards||[], (d.dealer&&d.dealer.cards)||[], h.cards||[], h.cashOut, followedBet).then(function(evr){
        var target=document.getElementById(elId)
        if(!target) return
        if(!evr){target.innerHTML='<span class="pp-ev-cell" style="font-size:10px">err</span>';return}
        var dmap={hit:'H',stand:'S',double:'D',cashout:'SR',split:'P'}
        var bCls=evr.best.decision.toLowerCase().replace(/ /g,'')
        var sCls=evr.second?evr.second.decision.toLowerCase().replace(/ /g,''):''
        var bTxt=(dmap[bCls]||evr.best.decision)+' '+evr.best.ev
        var sTxt=evr.second?(dmap[sCls]||evr.second.decision)+' '+evr.second.ev:''
        target.innerHTML='<span class="pp-ev-cell '+bCls+' best">'+bTxt+'</span>'+(sTxt?'<span class="pp-ev-cell '+sCls+' sec">'+sTxt+'</span>' : '<span class="pp-ev-cell sec">-</span>')
      })
    }
  }
}

