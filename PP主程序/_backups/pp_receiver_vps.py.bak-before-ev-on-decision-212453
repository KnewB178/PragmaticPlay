// EV service call
function evHtmlFor(cards, dealer, player){
  var key=(cards||[]).join(",")+"|"+(dealer||[]).join(",")+"|"+(player||[]).join(",")
  var evr=evCache[key]
  if(!evr) return '<span class="pp-ev-cell">-</span>'
  var dmap={hit:'H',stand:'S',double:'D',cashout:'SR',split:'P'}
  var bCls=evr.best.decision.toLowerCase().replace(/ /g,'')
  var sCls=evr.second?evr.second.decision.toLowerCase().replace(/ /g,''):''
  var bTxt=(dmap[bCls]||evr.best.decision)+' '+evr.best.ev
  var sTxt=evr.second?(dmap[sCls]||evr.second.decision)+' '+evr.second.ev:''
  return '<span class="pp-ev-cell '+bCls+' best">'+bTxt+'</span>'+(sTxt?'<span class="pp-ev-cell '+sCls+' sec">'+sTxt+'</span>' : '<span class="pp-ev-cell sec">-</span>')
}

async function fetchEv(cards, dealer, player, cashOut, betAmount){
  const key=cards.join(",")+"|"+dealer.join(",")+"|"+player.join(",")
  if(evCache[key]) return evCache[key]
  try{
    const r=await fetch("/ev",{
      method:"POST",headers:{"Content-Type":"application/json"},
      body:JSON.stringify({cards,dealer,player,cashOut,betAmount:betAmount||null})
    })
    if(!r.ok) return null
    const d=await r.json()
    evCache[key]=d
    return d
  }catch(e){return null}
}
