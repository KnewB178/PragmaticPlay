class Broadcaster:
    def __init__(self):
        self._clients = set()
        self._lock = asyncio.Lock()
    async def add(self, ws):
        async with self._lock: self._clients.add(ws)
    async def remove(self, ws):
        async with self._lock: self._clients.discard(ws)
    async def send(self, msg_type, payload):
        msg = json.dumps({"type": msg_type, "payload": payload})
        dead = set()
        async with self._lock:
            for ws in self._clients:
                try: await ws.send_str(msg)
                except: dead.add(ws)
            self._clients -= dead
    @property
    def count(self): return len(self._clients)

broadcast = Broadcaster()
main_loop = None

class MqttState:
    def __init__(self):
        self.connected = False
        self.total_msgs = 0
        self.last_msg_time = None
        self.reconnects = 0
        self.last_disconnect_reason = ""

state = MqttState()

def start_mqtt():
    c = mqtt.Client(protocol=mqtt.MQTTv311)

    def on_connect(client, userdata, flags, rc):
        state.connected = (rc == 0)
        if rc == 0:
            print(f"  [✅] MQTT Connected {MQTT_HOST}:{MQTT_PORT}")
            client.subscribe(MQTT_TOPICS)
        else:
            print(f"  [❌] MQTT 连接失败 rc={rc}")
        asyncio.run_coroutine_threadsafe(
            broadcast.send("status", {
                "mqtt": "connected" if rc == 0 else f"fail:{rc}",
                "reconnects": state.reconnects,
                "total_msgs": state.total_msgs,
                "last_msg": state.last_msg_time,
            }), main_loop)

    def on_disconnect(client, userdata, rc):
        state.connected = False
        state.reconnects += 1
        reason = {0: "正常断开", 1: "协议错误", 2: "被拒绝",
                  3: "服务器关闭", 4: "超时"}.get(rc, f"未知({rc})")
        state.last_disconnect_reason = reason
        print(f"  [⚠️] MQTT 断开 ({reason}), 尝试重连...")
        asyncio.run_coroutine_threadsafe(
            broadcast.send("status", {
                "mqtt": "disconnected", "disconnect_reason": reason,
                "reconnects": state.reconnects,
                "total_msgs": state.total_msgs,
                "last_msg": state.last_msg_time,
            }), main_loop)
        delay = min(2 ** (state.reconnects % 6), 30)
        time.sleep(delay)
        try:
            client.connect(MQTT_HOST, MQTT_PORT, MQTT_KEEPALIVE)
            print(f"  [🔄] 重连成功")
        except Exception as e:
            print(f"  [❌] 重连失败: {e}")

    def on_message(client, userdata, msg):
        state.total_msgs += 1
        now = datetime.now().strftime("%H:%M:%S")
        state.last_msg_time = now
        try:
            payload = json.loads(msg.payload)
        except json.JSONDecodeError:
            payload = {"raw": msg.payload.decode("utf-8", errors="replace")}
        data = {"topic": msg.topic, "time": now, "payload": payload}
        asyncio.run_coroutine_threadsafe(
            broadcast.send("mqtt_msg", data), main_loop)

    c.on_connect = on_connect
    c.on_disconnect = on_disconnect
    c.on_message = on_message
    c.username_pw_set(MQTT_USER, MQTT_PASS)
    try:
        c.connect(MQTT_HOST, MQTT_PORT, MQTT_KEEPALIVE)
        c.loop_start()
        return c
    except Exception as e:
        print(f"  [❌] MQTT 启动失败: {e}")
        return None

RESTART_COOLDOWN_SECONDS = 60
_last_restart_at = 0.0


def restart_password() -> str:
    try:
        parser = configparser.ConfigParser()
        parser.read(BASE_DIR / "config.ini", encoding="utf-8")
        return parser.get("web", "restart_password", fallback="PragmaticPlay").strip()
    except Exception:
        return "PragmaticPlay"


def restart_seconds_left() -> int:
    return max(0, int(RESTART_COOLDOWN_SECONDS - (time.time() - _last_restart_at)))


def restart_chain_running() -> bool:
    try:
        if os.name == "nt":
            cmd = (
                "Get-CimInstance Win32_Process | "
                "Where-Object { $_.CommandLine -like '*restart_chain.py*' -and $_.ProcessId -ne $PID } | "
                "ForEach-Object { $_.ProcessId }"
            )
            out = subprocess.run(
                ["powershell", "-NoProfile", "-Command", cmd],
                capture_output=True,
                text=True,
                check=False,
            ).stdout
            return any(line.strip().isdigit() for line in out.splitlines())
        out = subprocess.run(
            ["pgrep", "-f", "restart_chain.py"],
            capture_output=True,
            text=True,
            check=False,
        ).stdout
        return bool(out.strip())
    except Exception:
        return False


