@routes.get("/ws")
async def ws_handler(request):
    ws = web.WebSocketResponse()
    await ws.prepare(request)
    # Send current MQTT status immediately so badge shows right color
    from json import dumps as _jdumps
    await ws.send_str(_jdumps({
        "type": "status",
        "payload": {
            "mqtt": "connected" if state.connected else "disconnected",
            "reconnects": state.reconnects,
            "total_msgs": state.total_msgs,
            "last_msg": state.last_msg_time,
        }
    }))
    await broadcast.add(ws)
    try:
        async for _ in ws:
            pass
    except:
        pass
    finally:
        await broadcast.remove(ws)
    return ws

