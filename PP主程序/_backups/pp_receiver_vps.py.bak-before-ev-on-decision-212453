<script>
const $=s=>document.querySelector(s)
const tables={}
const evCache={}
let ws=null, curPlayerTable=null, sortMode='tc_desc'
const debounceTimers = {}
let followedPlayer = localStorage.getItem('ppFollowedPlayer') || ''
let followedBet = localStorage.getItem('ppFollowedBet') || ''

function connect(){
  const url=location.protocol==='https:'?'wss://':'ws://'+location.host+'/ws'
  ws=new WebSocket(url)
  ws.onopen=()=>{}
  ws.onmessage=e=>{
    try{
      const m=JSON.parse(e.data)
      if(m.type==='mqtt_msg' && m.payload.topic && m.payload.topic.startsWith('pp/table/')){
        const topic = m.payload.topic
        if(debounceTimers[topic]) clearTimeout(debounceTimers[topic])
        debounceTimers[topic] = setTimeout(function(){
          delete debounceTimers[topic]
          handleMsg(m.payload)
        }, 250)
      } else {
        if(m.type==='mqtt_msg') handleMsg(m.payload)
        else if(m.type==='status') handleStatus(m.payload)
      }
    }catch(_){}
  }
  ws.onclose=()=>{setBadge('gray','Disonnected');setTimeout(connect,3000)}
  ws.onerror=()=>{ws.close()}
}

function setBadge(clr,label){
  const b=$('#mqtt-badge')
  b.className='badge '+clr
  $('#mqtt-label').textContent=label||clr
}

function handleStatus(s){
  if(s.mqtt==='connected'){setBadge('green','Connected')}
  else{
    setBadge('red','Disconnected')
    // Clear all tables when disconnected
    Object.keys(tables).forEach(k=>delete tables[k])
    render()
  }
}

function handleMsg(d){
  if(d.topic.startsWith('pp/table/')){
    const name=d.topic.replace('pp/table/','')
    const p=d.payload||{}
    var oldTable=tables[name]
    tables[name]={
      tc:p.tc??0, total:p.total??0, pdev:(p.pdev??null),
      cards:p.cards||[],
      dealer:p.dealer||{},
      players:p.players||{},
      player_names:p.player_names||{},
      time:d.time,
      gameEnded: false
    }
    // Preserve cashOut values from old data if missing in new data
    // Skip when new payload is empty (betsopen round reset)
    var hasPlayers=p.players&&Object.keys(p.players).length>0
    if(oldTable&&oldTable.players&&hasPlayers){
      for(var k in oldTable.players){
        var oc=oldTable.players[k]
        if(oc.cashOut===undefined) continue
        var np=tables[name].players[k]
        if(!np) continue
        if(np.cashOut!==undefined) continue
        // No cashOut in new data - check if cards changed
        if((oc.cards||[]).join(',')===(np.cards||[]).join(',')){
          np.cashOut=oc.cashOut
        }
        // If cards changed, player made a decision, don't preserve
      }
    }
    render()
    if(curPlayerTable&&curPlayerTable===name) renderPlayerPanel(name)
    
    // Auto-follow: if tracking a player and they are on this table, switch
    if(followedPlayer){
      var pnames = tables[name]?.player_names || {}
      if(Object.values(pnames).some(function(v){return v.includes(followedPlayer)})){
        togglePlayerPanel(name)
      }
    }
  }
  
  if(d.topic.startsWith('pp/gameend/')){
    // gameEnd handled - no gray-out feature
  }
  const cnt=Object.keys(tables).length
  $('#table-count').textContent=cnt
  // Update tracking indicator based on whether player is found at any table
  if(followedPlayer){
    var _f=false
    for(var _t in tables){
      var _n=tables[_t].player_names||{}
      if(Object.values(_n).some(function(v){return v.includes(followedPlayer)})){_f=true;break}
    }
    $('#user-btn').classList.toggle('tracking',_f)
  }
}

function render(){
  const grid=$('#table-grid'), filter=''
