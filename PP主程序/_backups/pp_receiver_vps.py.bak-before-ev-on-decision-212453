  if(filter) entries=entries.filter(([n])=>n.toLowerCase().includes(filter))
  if(sort==='name') entries.sort((a,b)=>a[0].localeCompare(b[0],void 0,{numeric:true}))
  else if(sort==='tc_desc') entries.sort((a,b)=>{const pa=a[1].players?Object.keys(a[1].players).length:0;const pb=b[1].players?Object.keys(b[1].players).length:0;if(pa>=7&&pb<7)return 1;if(pb>=7&&pa<7)return -1;return b[1].tc-a[1].tc})
  if(!entries.length){
    grid.style.display='flex';grid.style.alignItems='center';grid.style.justifyContent='center';grid.style.height='100%'
    grid.innerHTML='<div class="empty-state"><div class="icon">&#x1F4E1;</div><p>Awaiting data...</p></div>'
    return
  }
  grid.style.display='';grid.style.alignItems='';grid.style.justifyContent='';grid.style.height=''
  let html=''
  for(const[name,d]of entries){
    const tc=d.tc??0
    const pdv=(d.pdev==null?null:Number(d.pdev)*100)
    const pcls=pdv==null?'tc-z':pdv>0?'tc-p':pdv<0?'tc-n':'tc-z'
    const psign=(pdv!=null&&pdv>0)?'+':''
    const tcsign=tc>0?'+':''
    const ts=d.time||'-'

    const pc=d.players?Object.keys(d.players).length:0
    html+='<div class="table-card">'
